{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archonix:schema:inventory:0.1",
  "title": "Archonix repository inventory",
  "description": "Static, file-based inventory. Produced without importing or executing repository code. Detections are evidence-backed and carry a basis; static inspection does not reveal every runtime dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "generated_at", "root", "repository", "scan", "languages", "manifests", "projects", "detections", "limitations"],
  "properties": {
    "kind": {"const": "inventory"},
    "schema_version": {"const": "0.1"},
    "example": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "object", "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "root": {"type": "string"},
    "repository": {"$ref": "#/$defs/repository"},
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_scanned", "truncated", "max_files", "excluded_dirs", "symlinks_skipped", "unreadable", "large_files"],
      "properties": {
        "files_scanned": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "max_files": {"type": "integer", "minimum": 1},
        "excluded_dirs": {"type": "array", "items": {"type": "string"}},
        "symlinks_skipped": {"type": "array", "items": {"type": "string"}},
        "unreadable": {"type": "array", "items": {"type": "string"}},
        "large_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "files", "bytes"],
        "properties": {"name": {"type": "string"}, "files": {"type": "integer"}, "bytes": {"type": "integer"}}
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "ecosystem"],
        "properties": {
          "path": {"type": "string"},
          "type": {"type": "string"},
          "ecosystem": {"type": "string"},
          "parse_error": {"type": ["string", "null"]}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ecosystems", "manifests"],
        "properties": {
          "path": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "ecosystems": {"type": "array", "items": {"type": "string"}},
          "manifests": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "name", "confidence", "basis", "evidence"],
        "properties": {
          "category": {"type": "string"},
          "name": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "basis": {"enum": ["declared-dependency", "config-file", "file-pattern", "manifest-field"]},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs", "revision", "branch", "dirty"],
      "properties": {
        "vcs": {"enum": ["git", "none"]},
        "revision": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
