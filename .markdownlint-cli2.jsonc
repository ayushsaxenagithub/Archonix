// markdownlint-cli2 configuration (run in CI by the "docs" job).
{
  "config": {
    "default": true,
    // Prose and wide tables are wrapped by hand; line length is not enforced.
    "MD013": false,
    // Compact "|---|" tables are used throughout; column alignment style is not enforced.
    "MD060": false,
    // Templates use <placeholder> tokens such as <sha> that are not HTML.
    "MD033": false,
    "MD024": { "siblings_only": true }
  },
  "ignores": [
    ".venv/**",
    "node_modules/**",
    "dist/**",
    "tests/fixtures/**",
    // Generated by `archonix render`; validated by schema and labelling tests instead.
    "examples/reports/**"
  ]
}
